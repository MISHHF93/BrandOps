{
  "name": "brandops-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:mobile": "node scripts/dev.mjs --open /",
    "dev:fullstack": "node scripts/full-stack-dev.mjs --open /mobile.html",
    "bridge:proxy": "node scripts/bridge-proxy.mjs",
    "bridge:proxy:local": "node scripts/bridge-proxy-local.mjs",
    "mcp:gateway": "node --import tsx scripts/mcp-gateway.mjs",
    "prebuild": "npm run brand:assets",
    "build": "tsc -b && vite build && node scripts/copy-manifest.mjs",
    "build:mobile": "tsc -b && vite build",
    "build:android-sync": "npm run build && npm run android:sync",
    "preview": "vite preview",
    "android:add": "cap add android",
    "cap:prepare": "node scripts/prepare-capacitor-web.mjs",
    "android:sync": "npm run cap:prepare && cap sync android",
    "android:open": "cap open android",
    "android:run": "npm run cap:prepare && cap run android",
    "ios:add": "cap add ios",
    "ios:sync": "npm run cap:prepare && cap sync ios",
    "ios:open": "cap open ios",
    "ios:run": "npm run cap:prepare && cap run ios",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest run",
    "test:unit": "node scripts/vitest-unit.mjs",
    "test:integration": "node scripts/vitest-integration.mjs",
    "test:perf": "vitest run tests/performance --reporter=verbose",
    "typecheck": "tsc -b",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "check": "npm run typecheck && npm run lint",
    "verify": "npm run check && npm run test",
    "report:resonance": "node scripts/generate-artifact-resonance-report.mjs",
    "monitor:ai": "node scripts/monitor-ai-stack.mjs",
    "local:model:pull": "node scripts/setup-local-inference.mjs pull",
    "local:model:smoke": "node scripts/setup-local-inference.mjs smoke",
    "local:model:env": "node scripts/setup-local-inference.mjs print-env",
    "native:model:train": "node scripts/train-native-model.mjs",
    "native:model:run": "node scripts/run-native-model.mjs",
    "verify:artifacts": "node scripts/verify-artifact-lock.mjs",
    "brand:assets": "node scripts/generate-brand-assets.mjs",
    "knip": "knip --no-exit-code --no-config-hints",
    "verify:dist": "node scripts/verify-dist.mjs",
    "package:release": "node scripts/package-release.mjs",
    "release": "npm run check && npm run format && npm run test && npm run test:integration && npm run build && npm run verify:dist && npm run package:release"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "@capacitor/ios": "^8.3.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.543.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.1",
    "@eslint/js": "^9.35.0",
    "@types/chrome": "^0.1.24",
    "@types/node": "^25.6.0",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "@vitejs/plugin-react": "^5.0.2",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.4.0",
    "jsdom": "^29.1.1",
    "knip": "^5.88.1",
    "postcss": "^8.5.6",
    "prettier": "^3.4.2",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^4.1.4"
  }
}
