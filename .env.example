# Copy to ".env.local" in the repo root (gitignored) for local OAuth and other Vite secrets.
# Chrome Web Store: register OAuth redirect URIs per provider; align listing answers with public/privacy-policy.html.
#
# Local dev is fixed to http://localhost:5173 (vite.config.ts strictPort). Free that port if `npm run dev` fails.
# OAuth redirect example: http://localhost:5173/oauth/google-brandops.html
#
# Optional: absolute deploy origin (no trailing slash) so Open Graph / Twitter preview images use full URLs at build time.
# VITE_PUBLIC_ORIGIN=https://your-app.vercel.app

# Public HTTPS URL to hosted privacy-policy.html (Chrome Web Store + Welcome / Settings links).
# VITE_PRIVACY_POLICY_URL=https://your-org.github.io/brandops/privacy-policy.html

# Publisher OAuth client IDs (optional; Welcome shows sign-in without pasting IDs in Settings).
# For hosted web (Vercel, etc.), register these redirect URLs on each provider:
#   https://YOUR_DEPLOYMENT/oauth/google-brandops.html
#   https://YOUR_DEPLOYMENT/oauth/github-brandops.html
#   https://YOUR_DEPLOYMENT/oauth/linkedin-brandops.html
# Extension builds still use the chrome-extension:// redirect from chrome.identity (see Settings).
# VITE_GOOGLE_CLIENT_ID=
# VITE_GITHUB_CLIENT_ID=
# VITE_LINKEDIN_CLIENT_ID=
#
# Alternative without rebuilding: edit public/brandops-oauth-public.json on the deployed site (googleClientId, etc.).
# Production requires federated sign-in (extension chrome.identity and/or VITE_* OAuth client IDs for web popup flow).

# --- Hosted preview only (Vercel demos) — omit for Chrome Web Store production builds ---
# VITE_VERCEL_PREVIEW_SIGNIN=1
# Shared secret (8+ chars). Magic link: https://YOUR_DEPLOYMENT/welcome.html?preview_magic=YOUR_SECRET
# VITE_PREVIEW_MAGIC_TOKEN=your-long-random-string
# Optional: one-click sign-in without a token (private demos only — anyone with the URL can enter).
# VITE_PREVIEW_OPEN_SIGNIN=1
#
# Local dev: open dashboard without OAuth (Vercel does this automatically when built on Vercel).
# On Vercel you can omit this, or set to 0 later to require federated sign-in.
# VITE_PREVIEW_COCKPIT_UNGATED=1
#
# Membership gate (Stripe): off by default — set only when billing is wired and you want to block non-subscribers.
# VITE_ENFORCE_MEMBERSHIP_GATE=1
# Optional static billing links for the in-app membership gate. Use HTTPS URLs from Stripe.
# VITE_STRIPE_CHECKOUT_URL=https://buy.stripe.com/...
# VITE_STRIPE_BILLING_PORTAL_URL=https://billing.stripe.com/p/session/...
#
# Skip the mobile launch sign-in wall (direct to Chat/workspace; Settings still has sign-in). Private demos only.
# VITE_SKIP_LAUNCH_AUTH=1

# --- Intelligence rules (optional) ---
# Default: same-origin `/brandops-intelligence-rules.json` copied from `public/` at build time.
# Override with any HTTPS JSON URL that returns a partial rules pack (see `public/brandops-intelligence-rules.example.json`).
# VITE_INTELLIGENCE_RULES_URL=https://your-cdn.example/brandops-intelligence-rules.json

# --- Hosted NLP (OpenAI-compatible) ---
# 401/403 from the inference URL almost always mean API key or model access — see Settings → AI bridge and worker model IDs.

# --- Optional webhook bridge proxy (local/server process, not bundled into the extension) ---
# BRIDGE_PROXY_PORT=8787
# BRIDGE_SHARED_SECRET=replace-with-a-long-random-secret
# BRIDGE_TARGET_URL=https://your-hosted-receiver.example/agent-bridge
# Local verification only: enables POST /agent-bridge on the bridge proxy itself.
# Production should leave this unset and use a real hosted receiver above.
# BRIDGE_ENABLE_LOCAL_RECEIVER=1
# TELEGRAM_WEBHOOK_TOKEN=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
